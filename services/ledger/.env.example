# Copy this file to .env and use it on your own machine. Never commit .env.
# All values below are fake. Real environments get their values from a secret store.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# --- Development database (docker compose service "db", port 5432) ---
# ADMIN: superuser. Used only by `npm run db:bootstrap`. Never give it to the running service.
ADMIN_DATABASE_URL=postgres://ledger_admin:change-me@localhost:5432/ledger_dev
# MIGRATION: owns the tables. Used only by `npm run migrate` and operator tools.
MIGRATION_DATABASE_URL=postgres://ledger_migrator:change-me-migrator@localhost:5432/ledger_dev
# APP: the limited role the running service uses.
DATABASE_URL=postgres://ledger_app:change-me-app@localhost:5432/ledger_dev

# --- Test database (docker compose service "db_test", port 5433) ---
TEST_ADMIN_DATABASE_URL=postgres://ledger_admin:change-me@localhost:5433/ledger_test
TEST_MIGRATION_DATABASE_URL=postgres://ledger_migrator:change-me-migrator@localhost:5433/ledger_test
TEST_DATABASE_URL=postgres://ledger_app:change-me-app@localhost:5433/ledger_test
